		<presentationTable>
			<presentation id="Pres_ABookViewType">
				<dropdownList
					refId="Pres_ABookViewType_DrpLst"
					noSort="true"
					defaultItem="0"
					>Address book view type:
				</dropdownList>
			</presentation>
			<presentation id="Pres_UiLang">
				<dropdownList
					refId="Pres_UiLang_DrpLst"
					noSort="true"
					defaultItem="5"
					>Choose one of the available languages:
				</dropdownList>
			</presentation>
			<presentation id="Pres_SecurityInteractiveAccess">
				<dropdownList
					refId="Pres_SecurityInteractiveAccess_DrpLst"
					noSort="true"
					defaultItem="1"
					>Interactive access mode:
				</dropdownList>
			</presentation>
			<presentation id="Pres_SecurityAclList">
				<multiTextBox
					defaultHeight="8"
					refId="Pres_SecurityAclList_MltTxtStr"
					>Set Access Control List:
				</multiTextBox>
			</presentation>
			<presentation id="Pres_PrivacyNameShow">
				<dropdownList
					refId="Pres_PrivacyNameShow_DrpLst"
					noSort="true"
					defaultItem="1"
					>Set the username:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyName">
				<textBox refId="Pres_PrivacyName_TxtStr">
					<label>Specify a custom username:</label>
					<defaultValue></defaultValue>
				</textBox>
			</presentation>
			<presentation id="Pres_PrivacyImageShow">
				<dropdownList
					refId="Pres_PrivacyImageShow_DrpLst"
					noSort="true"
					defaultItem="1"
					>Set the user image:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyBkgndShow">
				<dropdownList
					refId="Pres_PrivacyBkgndShow_DrpLst"
					noSort="true"
					defaultItem="1"
					>Desk Preview options:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyScrshotPathCfg">
				<dropdownList
					refId="Pres_PrivacyScrshotPathCfg_DrpLst"
					noSort="true"
					defaultItem="1"
					>Screenshot path:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyScrshotPath">
				<textBox refId="Pres_PrivacyScrshotPath_TxtStr">
					<label>Set the custom screenshot path:</label>
					<defaultValue></defaultValue>
				</textBox>
			</presentation>
			<presentation id="Pres_PrivacyChatPathCfg">
				<dropdownList
					refId="Pres_PrivacyChatPathCfg_DrpLst"
					noSort="true"
					defaultItem="1"
					>Chat Log path:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyScreenFrameMode">
				<dropdownList
					refId="Pres_PrivacyScreenFrameMode_DrpLst"
					noSort="true"
					defaultItem="0"
					>Screen Frame Mode:
				</dropdownList>
			</presentation>
			<presentation id="Pres_PrivacyScreenFrameColorDefault">
				<textBox refId="Pres_PrivacyScreenFrameColorDefault_TxtStr">
					<label>Screen Frame Default Color:</label>
					<defaultValue>#DDDDDD80</defaultValue>
				</textBox>
			</presentation>
			<presentation id="Pres_PrivacyScreenFrameColorWatched">
				<textBox refId="Pres_PrivacyScreenFrameColorWatched_TxtStr">
					<label>Screen Frame Watched Color:</label>
					<defaultValue>#EF443B80</defaultValue>
				</textBox>
			</presentation>
			<presentation id="Pres_PrivacyScreenFrameWidth">
				<decimalTextBox
					refId="Pres_PrivacyScreenFrameWidth_TxtDec"
					defaultValue="10"
					>Screen Frame width in absolute pixels
				</decimalTextBox>
			</presentation>
			<presentation id="Pres_ImageQualityPreset">
				<dropdownList
					refId="Pres_ImageQualityPreset_DrpLst"
					noSort="true"
					defaultItem="1"
					>Select Display Quality options:
				</dropdownList>
			</presentation>
			<presentation id="Pres_ImageViewmode">
				<dropdownList
					refId="Pres_ImageViewmode_DrpLst"
					noSort="true"
					defaultItem="1"
					>Choose the view mode:
				</dropdownList>
			</presentation>
			<presentation id="Pres_ImageRendermode">
				<dropdownList
					refId="Pres_ImageRendermode_DrpLst"
					noSort="true"
					defaultItem="2"
