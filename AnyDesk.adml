				</decimalTextBox>
			</presentation>
			<presentation id="Pres_UiMainWinHeight">
				<decimalTextBox
					refId="Pres_UiMainWinHeight_TxtDec"
					defaultValue=""
					>Set the window height in pixels:
				</decimalTextBox>
			</presentation>
