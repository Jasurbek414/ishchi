# Nusxa oling: cp .env.example .env va qiymatlarni to'ldiring. .env fayli git'ga committalanmaydi.

DB_NAME=ishchi
DB_USER=ishchi
DB_PASSWORD=change-me

# kamida 32 belgi, tasodifiy va maxfiy bo'lishi kerak
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# Vergul bilan ajratilgan ro'yxat, yoki * (hammasi). Admin panel va landing backend bilan bir
# xil originda bo'lgani uchun ularga ta'sir qilmaydi.
CORS_ALLOWED_ORIGINS=*

# Backend ochiq internetdan qanday manzilda ko'rinadi. Telegram webhook va botga ulanish
# havolalari shu qiymatdan quriladi — noto'g'ri bo'lsa bot ishlamaydi.
APP_BASE_URL=https://api.uzbishchi.uz

# birinchi administrator akkaunti (bo'sh qoldirilsa yaratilmaydi)
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=change-me

# Cloudflare Zero Trust > Networks > Tunnels'dan olinadi (bitta tunnel — barcha domenlar: API, admin panel, landing sahifa)
CLOUDFLARE_LANDING_TUNNEL_TOKEN=change-me

# Push-bildirishnoma (Firebase Cloud Messaging). Xizmat hisobi JSON faylini
# backend/secrets/firebase-service-account.json sifatida qo'ying — u konteynerga
# /app/secrets katalogi orqali ulanadi. Fayl bo'lmasa push-bildirishnomalar shunchaki
# o'chirilgan holatda ishlaydi, qolgan hammasi ishlayveradi.
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
