# Nusxa oling: cp .env.example .env va qiymatlarni to'ldiring. .env fayli git'ga committalanmaydi.

DB_NAME=ishchi
DB_USER=ishchi
DB_PASSWORD=change-me

# kamida 32 belgi, tasodifiy va maxfiy bo'lishi kerak
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=*

# birinchi administrator akkaunti (bo'sh qoldirilsa yaratilmaydi)
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=change-me

# Cloudflare Zero Trust > Networks > Tunnels'dan olinadi
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Push-bildirishnoma (Firebase Cloud Messaging). Xizmat hisobi JSON fayli konteyner ichida
# shu yo'lda bo'lishi kerak (docker-compose.yml'dagi volume orqali). Bo'sh qoldirilsa
# push-bildirishnomalar shunchaki o'chirilgan holatda ishlaydi, ilova baribir ishlayveradi.
FIREBASE_CREDENTIALS_PATH=/app/firebase-service-account.json
